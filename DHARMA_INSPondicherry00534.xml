                </lg>
                <p xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                    <lb n="4"/>Iṉāṉilamkaḷu<supplied reason="omitted">m</supplied> kuḻikkar<choice><orig>aiI</orig><reg>aiyi</reg></choice>lē ku<supplied reason="omitted">ṭu</supplied>t=ta mānyam
