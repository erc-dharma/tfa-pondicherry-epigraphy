            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/><hi rend="grantha">śrī</hi>-kaṉṉara-<hi rend="grantha">de</hi>varkku yāṇṭu <num value="24">2 <g type="numeral">10</g> 4</num>-vatu
                </p>
                <p>
                    vā
                    <lb n="2" break="no"/>kūr <hi rend="grantha">śrī</hi>-m<choice><orig>u</orig><reg>ū</reg></choice>la<hi rend="grantha">stā</hi>ṉattu-p <hi rend="grantha">m<choice><sic>ā</sic><corr>a</corr></choice>hāde</hi>vark
                    <lb n="3" break="no"/>ku ka<unclear>rai</unclear> Uṭaiyāṉ kaliyaṉ maṉṟāṭi
                    <lb n="4"/>Aiyya<choice><orig>ṉṉ</orig><reg>ṉ</reg></choice>-ākiya Irā<hi rend="grantha">jā</hi>ti<supplied reason="omitted">t</supplied>ta-p-pēr-araiya
                    <lb n="5" break="no"/>ṉ tiru-Uṇṇāḷikaiyil muṉpil ma
                    <lb n="6" break="no"/>ṇṭapattil mēl-kkaṭain=ta Oḻukil
                    <lb n="7"/>tūṇ Iraṇṭum Araikkāl Iraṇṭu<supplied reason="omitted">m</supplied>
                    <lb n="8"/>Uttiramum Ivv-oḻukukku vēṇṭuva
                    <lb n="9" break="no"/>ṉa ellāñ ce<supplied reason="omitted">y</supplied>tu vaittāṉ
                </p>
                <p>
                    Itu cantirāti<supplied reason="omitted">t</supplied>taval <g ref="sym:flourish-taperOut" type="punctuation">.</g>
                </p>
                
            </div>
            
