        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <ab>		
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>
                    kaṉṉara-tēvarkku yāṇṭu <num value="22">2 <g type="numeral">10</g> 2</num><g ref="sym:dash" type="punctuation">.</g>Āvatu
                </p>
                
                <p>                    
                    <lb n="2"/>vākūr <hi rend="grantha">mahāsabhai</hi>yōm Ā<hi rend="grantha">dhi</hi>rā<hi rend="grantha">ja</hi>maṅka<hi rend="grantha">lya</hi>purattu <hi rend="grantha">vyā</hi>pā
                    <lb n="3" break="no"/>ritīraṉ murukaṉukku Oṭṭikkuṭutta paric’ āvatu
                </p>
                
                <p>
                    Ivv-ūr teṉ
                    <lb n="4" break="no"/>piṭākai compiḷipākkattu Oṭṭaṅkollaiyil <hi rend="grantha">sabhai</hi>yōm
                    <lb n="5"/>pakkal Iṟaiyili-y-āka vilai koṇṭu Ivv-ūr Iruntu <hi rend="grantha">vyākhyā</hi>nañ cey
                    <lb n="6" break="no"/>yum <hi rend="grantha">bha</hi>ṭṭa<supplied reason="omitted">r</supplied>kaḷukku <hi rend="grantha">bha</hi>ṭṭa<hi rend="grantha">vṛ</hi>t=tiyāka vaitta karuttu-c-ceṟuvu nūṟum <hi rend="grantha">candrā</hi>ti
                    <lb n="7" break="no"/><hi rend="grantha">tya</hi>val <hi rend="grantha">bha</hi>ṭṭa<hi rend="grantha">vṛ</hi>t=ti y-āvat’ ākavum
                </p>
                <p>
                    In-nilañ cuṭṭi Eppērppaṭṭa
                    <lb n="8"/>Ūr-iṭu varippāṭuṅ kāṭṭa-p peṟātōm ākavum
                </p>
                <p>
                    I<hi rend="grantha">dhanma</hi>m <hi rend="grantha">sabhai</hi>yō
                    <lb n="9" break="no"/>m niṟutti-k kuṭuppat' ākavum
                </p>
                <p>
                    Itu Iṟakkuvataṟku-p paṟṟāṉ-āṉa Ivaṉ Āṟu
                    <lb n="10"/>pattu muntuṟṟārē <hi rend="grantha">dhanmāsa</hi> mutalāka mun=tuṟṟa kovukkē taravukkē vā<hi rend="grantha">si</hi>ttu
                    <lb n="11"/>taṇṭam Iṭa-p peṟuvatāka <hi rend="check">vuppaṭṭum</hi> I<hi rend="grantha">dharma</hi>m niṟutti-k kuṭuppat' ākavum
                </p>
                <p>
                    Ip
                    <lb n="12" break="no"/>pparic' oṭṭi-k kkuṭuttōm vākūr <hi rend="grantha">sabhai</hi>yōm paṇiyāl <hi rend="grantha">madhyasta</hi>ṉ Āyira
                    <lb n="13" break="no"/>ttaiññūṟṟuvaṉ eḻuttu <supplied reason="subaudible"><g ref="sym:doubleBar" type="punctuation">.</g></supplied>
                </p>
            </div>
            
            <div type="apparatus">
                <listApp>
                    <app loc="11">
                        <lem>vuppaṭṭum</lem>
                        <rdg source="bib:SubrahmanyaAiyer1932_01">vu<supplied reason="omitted">ṭ</supplied>ppaṭṭum</rdg>
                        <rdg source="bib:Kuppusamy+Vijayavenugopal2006_01">vuppaṭṭum</rdg>
                    </app>
                    <app loc="13">
                        <lem source="bib:Kuppusamy+Vijayavenugopal2006_01">°ñūṟṟuvaṉ</lem>
                        <rdg source="bib:SubrahmanyaAiyer1932_01">nūṟṟuvaṉ</rdg>
                    </app>
                </listApp>
            </div>
            
            <div type="translation" source="bib:Kuppusamy+al2010_01">
                <p>Hail! Prosperity!</p>
                <p>22nd year <supplied reason="subaudible">of the reign</supplied> of Kaṉṉara-tēvar.</p> 
            </div>
            
