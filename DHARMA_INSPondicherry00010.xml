        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                  <ab>		
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>
                    v<choice><orig>i</orig><reg>ī</reg></choice>ra-pāṇṭiyaṉ talai koṇṭa kō
                    <lb n="2" break="no"/>-parakē<hi rend="grantha">sa</hi>ri-pa<hi rend="grantha">nma</hi><reg>r</reg>kku yāṇṭu 3-vatu
                </p>
                <p>
                    vākūr <hi rend="grantha">śrī</hi>-m<choice><orig>u</orig><reg>ū</reg></choice>
                    <lb n="3" break="no"/>la<hi rend="grantha">s<choice><orig>t</orig><reg>th</reg></choice>ā</hi>ṉattu <hi rend="grantha">mahāde</hi>va<reg>r</reg>kku-c cempūr-k-kōṭṭattu
                    <lb n="4"/>netim<choice><orig>u</orig><reg>ū</reg></choice>r-nāṭṭu-k karai Uṭaiyā<supplied reason="omitted">ṉ</supplied> kaliyaṉ maṉṟāti Aiyya
                    <lb n="5" break="no"/><choice><orig>ṉṉ</orig><reg>ṉ</reg></choice>-ākiya Ācārakānta-p-palla
                    <lb n="6" break="no"/>raiyaṉ ca<hi rend="grantha">n<choice><orig>t</orig><reg>d</reg></choice>rā</hi>ti<supplied reason="omitted">t</supplied>taval vaitta na
                    <lb n="7" break="no"/>n=tā-viḷakk' oṉṟiṉukku vaitta cāvā
                    <lb n="8"/>m<choice><orig>u</orig><reg>ū</reg></choice>vā-p pēr-āṭu toṇṇūṟṟ' āṟu
                    <lb n="9"/>Eriya vaitta nilai-viḷakk' o
                    <lb n="10" break="no"/>ṉṟu
                </p>
                <p>
                    Ivai paṉmayē<surplus><hi rend="grantha">ha</hi></surplus><hi rend="grantha">śva</hi>
                    <lb n="11" break="no"/><hi rend="grantha">ra</hi> I<hi rend="grantha">rakṣai</hi>
                </p>
                
