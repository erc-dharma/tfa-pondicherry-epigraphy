                <ab>		
                    <lb n="1"/><hi rend="grantha">svasti </hi>
                </ab>
                
                <p>
                    <hi rend="grantha">śrīma</hi>ṉ <hi rend="grantha">māhā</hi>maṇṭal<choice><orig>i</orig><reg>ī</reg></choice>curaṉ kaṇṭa nāṭu koṇṭu koṇṭa nāṭu kuṭātāṉ pūṟuva-te<hi rend="grantha">kṣa</hi>ṇa-pa<unclear>cca</unclear>m <gap reason="lost" quantity="4" unit="character"/> <unclear>ca</unclear>tuṟu-camu<hi rend="grantha">drā</hi>tipati <gap reason="lost" quantity="4" unit="character"/>
                    <lb n="2"/>virupā<hi rend="grantha">kṣa</hi>-tēva-mā<unclear>hā</unclear>-Irāyar <hi rend="grantha">pra</hi>tivi <gap reason="lost" quantity="5" unit="character"/> kara saṅvatsarattu <hi rend="grantha">siṃha</hi>-nāyarru <hi rend="grantha">pū</hi>ṟuva-pa<hi rend="grantha">kṣa</hi>ttu <hi rend="grantha">deśa</hi>mi<unclear>yum</unclear> cukkila-vāramum peṟṟa <gap reason="lost" quantity="4" unit="character"/>
                </p>
                
