        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>		
                    <lb n="1"/>pāṟppati Ammai mukamaṇai Oṉṟu
                    <lb n="2"/>nam poṉ mukamaṇai Oṉṟu
                </p>
                
                <p>                    
                    <lb n="3" /><hi rend="grantha">śrī</hi>-kaṉṉāra-tēvarkki yāṇṭu
                    <lb n="4" /><num value="22">2 <g type="numeral">10</g> 2</num>-Āvatu
                </p>
                
                <p>
                    <hi rend="grantha">śrī</hi>-m<choice><orig>u</orig><reg>ū</reg></choice>la<hi rend="grantha">stā</hi>ṉa
                    <lb n="5" break="no"/>m A<hi rend="grantha">ṃśa</hi>m-uṭaiya tiru-k-kōyil Uṭaiyār Elārmāyapāṟppati
                    <lb n="6"/>parammaikku <hi rend="grantha"><choice><sic>ś</sic><corr>c</corr></choice>antrā</hi>ti<hi rend="grantha">tya</hi>val Erikka <supplied reason="omitted">ka</supplied>ṭava cāmaviḷakku O
                    <lb n="7" break="no"/>ṉṟu 
                </p>
            </div>
            
            <div type="apparatus">
                <listApp>
                    <app loc="5">
                        <lem source="bib:Kuppusamy+Vijayavenugopal2006_01">tiru-k-kōyil Uṭaiyār</lem>
                        <rdg source="bib:SubrahmanyaAiyer1932_01">tirukkōyiluṭaiyār</rdg>
                    </app>     
                    <app loc="7">
                        <lem source="bib:Kuppusamy+Vijayavenugopal2006_01"><supplied reason="omitted">ka</supplied>ṭava cāmaviḷakku</lem>
                        <rdg source="bib:SubrahmanyaAiyer1932_01"><supplied reason="omitted">ka</supplied>ṭavā<hi rend="grantha">rā</hi> <supplied reason="omitted">kavu</supplied>m viḷakku</rdg>
                    </app>    
                </listApp>
            </div>
            
            <div type="translation" source="bib:Kuppusamy+al2010_01">
                <p n="1"><supplied reason="subaudible">There shall be</supplied> one face mask for Pāṟppati Ammai.</p>
                <p n="2"><supplied reason="subaudible">There shall be</supplied> one face mask made out of good gold.</p>
                <p n="3-4">22nd year <supplied reason="subaudible">of the reign</supplied> of śrī-Kaṉṉara-tēvar, one mid-night lamp to be burnt, as long as the moon and the sun will last, to <!--Elārmāya--> Pārppati Parammai, a part of the Lord of the sacred temple of śrī-Mūlastāṉam of Vākūr.</p>
            </div>
            
            <div type="commentary">
                <p n="1-2">The first two lines should come at the end; but due to non-availability of space they were inscribed above.</p>
            </div>
            
