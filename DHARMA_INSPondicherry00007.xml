                <p>
                    <lb n="1"/><hi rend="grantha">śrī</hi>-kaṉṉara-<hi rend="grantha">de</hi>varkku yā
                    <lb n="2" break="no"/>ṇṭu <num value="26">2 <g type="numeral">10</g> 6</num>-Āvatu
                </p>
                <p>
                    na
                    <lb n="3" break="no"/>mi nākaṉ caṅkara<supplied reason="omitted">ṉ</supplied> I
                    <lb n="4" break="no"/>ppaṭaikku vaicca
                    <lb n="5"/>kallu nālu <g ref="sym:flourish-taperOut" type="punctuation">.</g>
                </p>
                
            </div>
            
            <div type="apparatus">
