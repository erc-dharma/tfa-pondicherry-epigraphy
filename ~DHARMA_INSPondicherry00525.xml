                <p>		
                    <lb n="1"/>
                    <gap reason="lost"/>
                    <unclear>cakkarava</unclear>ttikal <hi rend="grantha">śrī-rāja-rāja-de</hi>vaṟku
                    <gap reason="lost"/>
                    
                    <lb n="2"/>
                    <gap reason="lost"/>
                    p nāyaṟṟu <hi rend="grantha">Apara-pakṣa</hi>t<unclear>tu</unclear>
                    <gap reason="lost"/>
                    
                    <lb n="3"/>
                    <gap reason="lost"/>
                    ...
                    <gap reason="lost"/>
                    
                    <lb n="21"/>
                    <gap reason="lost"/>
                    Ivviḻiyūr-uṭaiyāṉ Araiyaṉ Uṭaiya nampiyar-āṉa ko
                    <gap reason="lost"/>
                </p>
                
